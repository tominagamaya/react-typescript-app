{
  "name": "react-typescript-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:front": "pnpm dev",
    "dev:server": "pnpm --filter server dev",
    "dev:all": "concurrently \"pnpm dev:front\" \"pnpm dev:server\"",
